# Supabase: URL del proyecto y llave anónima (cliente de lectura)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase: llave service_role, solo en servidor (escrituras; ignora RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Amazon SP-API: credenciales LWA (Catalog Items, Pricing y Fees)
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_REFRESH_TOKEN=

# Anthropic API: la lee el SDK de Anthropic para todas las llamadas a Claude
ANTHROPIC_API_KEY=

# HTTP Basic Auth de las rutas internas (src/proxy.ts)
SCOUT_AUTH_USER=
SCOUT_AUTH_PASSWORD=

# Apify: token de la cuenta, compartido por reviews y proveedores
APIFY_API_TOKEN=
# Apify: actor de reviews de Amazon (Review Intelligence y Product Analyst)
APIFY_REVIEWS_ACTOR_ID=
# Apify: actor de proveedores de Alibaba (Supplier)
APIFY_SUPPLIER_ACTOR_ID=
# Máximo de ASINs por corrida de Review Intelligence (default 5)
REVIEW_AGENT_MAX_ASINS_PER_RUN=
